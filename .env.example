# Copy this file to .env and fill in your secrets. NEVER commit .env.
# In GitHub Actions these are set as repository Secrets (Settings -> Secrets -> Actions).
# ---------------------------------------------------------------------------

# --- SMTP / Email ---------------------------------------------------------
# Hostinger mailbox: host smtp.hostinger.com, port 465 (SSL) or 587 (STARTTLS).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your-mailbox-password
SMTP_USE_SSL=true
EMAIL_FROM=you@yourdomain.com
EMAIL_TO=you@yourdomain.com                 # comma-separate multiple recipients

# --- FTP deploy to Hostinger (publishes the static dashboard) -------------
# Find these in hPanel -> Files -> FTP Accounts. Use FTPS if your plan supports it.
FTP_HOST=ftp.yourdomain.com
FTP_PORT=21
FTP_USER=your-ftp-user
FTP_PASSWORD=your-ftp-password
FTP_REMOTE_DIR=public_html                  # where the site is served from
FTP_USE_TLS=true

# --- Position sizing (used to size the suggested risk per trade) ----------
ACCOUNT_CAPITAL=1000000                      # total capital in INR
RISK_PCT_PER_TRADE=1.0                        # risk 1% of capital per swing trade

# --- Optional news API keys (RSS works without any of these) --------------
MARKETAUX_API_KEY=
FINNHUB_API_KEY=
NEWSAPI_KEY=
