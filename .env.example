# Copy this file to .env and fill in your secrets. NEVER commit .env.
# For running manually on your PC, only the SMTP section is required.
# ---------------------------------------------------------------------------

# --- SMTP / Email (REQUIRED to receive the digest) ------------------------
# Use any mailbox that allows SMTP. Common options:
#   Gmail:      smtp.gmail.com : 465 (SSL)  - password must be an APP PASSWORD
#               (Google account -> Security -> 2-Step Verification -> App passwords)
#   Outlook:    smtp-mail.outlook.com : 587 (set SMTP_USE_SSL=false)
#   Hostinger:  smtp.hostinger.com : 465 (SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_USE_SSL=true
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=                              # optional display name shown as the sender
EMAIL_TO=you@example.com                      # comma-separate; these are always BCC'd
EMAIL_SELF_COPY=                              # gets the visible To: copy; defaults to EMAIL_FROM

# --- Position sizing (used to size the suggested risk per trade) ----------
ACCOUNT_CAPITAL=1000000                        # total capital in INR
RISK_PCT_PER_TRADE=1.0                          # risk 1% of capital per swing trade

# --- OPTIONAL: publish the dashboard to a website via FTP -----------------
# Only needed if you run with `--deploy` (e.g. `nifty-scanner run-eod --deploy`).
# Leave blank for manual PC use - the dashboard is always written locally to
# output/site/index.html regardless.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=public_html
FTP_USE_TLS=true
SITE_URL=                                       # optional; shown as a link in emails

# --- Optional news API keys (RSS works without any of these) --------------
MARKETAUX_API_KEY=
FINNHUB_API_KEY=
NEWSAPI_KEY=
